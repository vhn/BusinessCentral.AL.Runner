// SourceTable, V — the BYSTANDER. Never edited, so it is always resolved from the packaged
// baseline, and its serialized PageDefinition names the table by name in `SourceTable`.
page 72121 "BN SourceTable Page"
{
    PageType = Card;
    SourceTable = "BN SourceTable Target";

    layout
    {
        area(Content)
        {
            field(No; Rec."No.") { ApplicationArea = All; }
            field(Description; Rec.Description) { ApplicationArea = All; }
        }
    }
}
