// RoleCenter, W — a profileextension is the ONLY AL construct that binds a profile, so this
// is the tightest W the language allows for this shape: `extends` forces the bystander
// profile — role-centre name and all — out of the packaged baseline.
profileextension "BN RoleCenter Ext" extends "BN RoleCenter Profile"
{
    Caption = 'rolecenter-ext-v1';
}
